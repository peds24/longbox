# Local development only. EAS builds read these from EAS environment variables
# instead (this file is gitignored and never reaches the build server) — see the
# "Building" section of the README.
EXPO_PUBLIC_METRON_USERNAME=
EXPO_PUBLIC_METRON_PASSWORD=
# Optional — Google Books works unauthenticated too, just at a lower quota.
# Only used as a fallback when OpenLibrary doesn't have a given ISBN.
EXPO_PUBLIC_GOOGLE_BOOKS_API_KEY=
